<odoo>
    <!-- Agreement List View-->
    <record model="ir.ui.view" id="partner_agreement_list_view">
        <field name="name">Agreement List</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement.agreement_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="active" column_invisible="1" />
            </xpath>
        </field>
    </record>

    <!-- Agreement Form View-->
    <!-- inherit agreement.agreement_form and transform it into the legal partner form -->
    <record id="partner_agreement_form_view" model="ir.ui.view">
        <field name="name">Agreement Form</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement.agreement_form" />
        <field name="arch" type="xml">
            <!-- 4) Add string "General" to group main -->
            <xpath
                expr="//group[@name='main']/group[@name='left']"
                position="attributes"
            >
                <attribute name="string">General</attribute>
            </xpath>
            <xpath
                expr="//group[@name='main']/group[@name='right']"
                position="attributes"
            >
                <attribute name="string">Term Dates</attribute>
            </xpath>
            <!-- 5) make code readonly -->
            <xpath expr="//field[@name='code']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- 7) remove "domain" field from base form -->
            <xpath expr="//field[@name='domain']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- edit attributes of moved date fields -->
            <xpath expr="//field[@name='signature_date']" position="attributes">
                <attribute name="invisible">is_template</attribute>
            </xpath>
            <xpath expr="//field[@name='start_date']" position="attributes">
                <attribute name="required">not is_template</attribute>
                <attribute name="invisible">is_template</attribute>
            </xpath>
            <xpath expr="//field[@name='end_date']" position="attributes">
                <attribute name="required">not is_template</attribute>
                <attribute name="invisible">is_template</attribute>
            </xpath>

            <!-- 8) is_template: make invisible and remove groups restriction -->
            <xpath expr="//field[@name='is_template']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="groups" />
            </xpath>

            <!-- 10) move agreement_type_id to right group and add extra fields -->
            <xpath
                expr="//sheet/group[@name='main']/group[@name='left']"
                position="inside"
            >
                <!-- <field name="agreement_type_id" position="move" /> -->
                <field
                    name="assigned_user_id"
                    invisible="is_template"
                    readonly="is_template"
                />
                <field name="active" invisible="1" />
            </xpath>

            <!-- 11) edit agreement_type_id attributes -->
            <xpath expr="//field[@name='agreement_type_id']" position="attributes">
                <attribute name="widget">selection</attribute>
                <attribute name="required">1</attribute>
                <attribute name="groups" />
            </xpath>

            <!-- 12) Add description after main group -->
            <xpath expr="//notebook" position="inside">
                <page name="description" string="Description">
                    <field name="description" nolabel="1" required="1" />
                </page>
            </xpath>

            <!-- 14) edit partner_id attributes -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="widget">res_partner_many2one</attribute>
                <attribute name="context">{'show_address': 1}</attribute>
                <attribute name="options">{'always_reload': True}</attribute>
                <attribute name="class">o_address_format</attribute>
                <!-- remove required="not is_template" -->
                <attribute name="required">0</attribute>
            </xpath>

            <!-- 15) edit company_id attributes -->
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="options">{'always_reload': True}</attribute>
                <attribute name="class">o_address_format</attribute>
            </xpath>

            <!-- 16) Insert Parties block after dynamic fields block -->
            <xpath expr="//group[@name='main']" position="after">
                <group name="parties">
                    <group name="partner" string="Partner" />
                    <group name="company" string="Company" />
                </group>
            </xpath>
            <!-- 17) move company_id and partner_id -->

            <xpath expr="//group[@name='company']" position="inside">
                <field name="company_id" position="move" />
                <field name="company_partner_id" invisible="1" />
                <field
                    name="company_contact_id"
                    domain="[('parent_id', '=', company_partner_id)]"
                    widget="res_partner_many2one"
                    context="{'show_email': 'customer', 'show_phone': True, 'show_address': True}"
                />
                <field name="company_contact_phone" widget="phone" readonly="1" />
            </xpath>
            <xpath expr="//group[@name='partner']" position="inside">
                <field name="partner_id" position="move" />
                <field
                    name="partner_contact_id"
                    domain="[('parent_id', '=', partner_id)]"
                    widget="res_partner_many2one"
                    context="{'show_email': 'customer', 'show_phone': True, 'show_address': True}"
                />
                <field name="partner_contact_phone" widget="phone" readonly="1" />
            </xpath>

            <!-- 17) Insert "Special Terms" after parties -->
            <xpath expr="//group[@name='parties']" position="after">
                <group string="Special Terms">
                    <field name="special_terms" nolabel="1" colspan="2" />
                </group>
            </xpath>

            <!-- 20) Insert Administration + footer after notebook -->
            <xpath expr="//sheet/notebook" position="after">
                <group name="administration" string="Administration">
                    <group>
                        <field name="reviewed_user_id" />
                        <field name="reviewed_date" />
                    </group>
                    <group>
                        <field name="approved_user_id" />
                        <field name="approved_date" />
                    </group>
                </group>

                <p name="footer">
                    Created By:
                    <field name="create_uid" readonly="1" />
                    |
                    Created On:
                    <field name="create_date" readonly="1" />
                </p>
            </xpath>
        </field>
    </record>

    <!-- Agreement Search View -->
    <record model="ir.ui.view" id="partner_agreement_search_view">
        <field name="name">Agreement Search</field>
        <field name="model">agreement</field>
        <field name="arch" type="xml">
            <search string="Agreement Search">
                <field name="code" />
                <field name="name" />
                <field name="partner_id" />
                <field name="agreement_type_id" />
                <filter
                    name="filter_non_template"
                    string="Non-Templates"
                    domain="[('active','=',True),('is_template', '=', False)]"
                />
                <filter
                    name="filter_inactive"
                    string="Archived"
                    domain="[('active','=',False)]"
                />
                <filter
                    name="filter_templates"
                    string="Templates"
                    domain="[('active','=',True),('is_template', '=', True)]"
                />
                <filter
                    name="group_partner_id"
                    string="Partners"
                    icon="terp-partner"
                    context="{'group_by':'partner_id'}"
                />
                <filter
                    name="group_agreement_type_id"
                    string="Agreement Type"
                    icon="terp-partner"
                    context="{'group_by':'agreement_type_id'}"
                />
            </search>
        </field>
    </record>

    <!-- Agreement Kanban View -->
    <record id="agreement_kanban" model="ir.ui.view">
        <field name="name">Agreement Kanban</field>
        <field name="inherit_id" ref="agreement.agreement_kanban" />
        <field name="model">agreement</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="highlight_color">color</attribute>
            </xpath>
            <xpath expr="//kanban" position="inside">
                <field name="color" />
                <field name="assigned_user_id" />
            </xpath>
            <xpath expr="//templates/t[@t-name='menu']" position="inside">
                <div role="separator" class="dropdown-divider" />
                <field name="color" widget="kanban_color_picker" />
            </xpath>
            <xpath expr="//field[@name='agreement_type_id']" position="after">
                <field
                    name="assigned_user_id"
                    widget="many2one_avatar_user"
                    class="ms-2"
                />
            </xpath>
        </field>
    </record>

    <!-- Agreement Reporting -->
    <record id="agreement_graph_view" model="ir.ui.view">
        <field name="name">agreement.graph</field>
        <field name="model">agreement</field>
        <field name="arch" type="xml">
            <graph string="Agreements" type="bar" />
        </field>
    </record>

    <record id="agreement_pivot_view" model="ir.ui.view">
        <field name="name">agreement.pivot</field>
        <field name="model">agreement</field>
        <field name="arch" type="xml">
            <pivot string="Agreements" display_quantity="true" />
        </field>
    </record>

    <record id="action_agreement_report_order" model="ir.actions.act_window">
        <field name="name">Agreements</field>
        <field name="res_model">agreement</field>
        <field name="view_mode">graph,pivot</field>
    </record>

    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="agreement_operations_agreement">
        <field name="name">Agreements</field>
        <field name="res_model">agreement</field>
        <field name="domain">[('is_template', '=', False)]</field>
        <field name="context">{'default_is_template': False}</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
